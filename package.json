{
  "name": "dollar-outlook",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/app/main.ts --bundle --format=esm --target=es2020 --minify --sourcemap --outfile=public/app.js",
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.app.json",
    "test": "node --test \"test/*.test.ts\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "esbuild": "^0.25.10",
    "typescript": "^5.6.3",
    "wrangler": "^4.151.3"
  }
}
